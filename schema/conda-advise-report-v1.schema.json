{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jezdez.github.io/conda-advise/schema/conda-advise-report-v1.schema.json",
  "title": "conda-advise report version 1",
  "description": "Machine-readable output from conda advise --json.",
  "oneOf": [
    {"$ref": "#/$defs/report"},
    {"$ref": "#/$defs/errorReport"}
  ],
  "$defs": {
    "provider": {
      "type": "string",
      "enum": ["osv", "basilisk"]
    },
    "severity": {
      "type": "string",
      "enum": ["unknown", "low", "medium", "high", "critical"]
    },
    "failureReason": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Stable machine-readable reason code. Consumers must tolerate new codes added during the v1 release line."
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "build",
        "build_number",
        "subdir",
        "channel",
        "url",
        "filename",
        "sha256",
        "md5"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "version": {"type": "string"},
        "build": {"type": "string"},
        "build_number": {"type": "integer"},
        "subdir": {"type": "string"},
        "channel": {"type": "string"},
        "url": {"type": "string"},
        "filename": {"type": "string"},
        "sha256": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
            {"type": "null"}
          ]
        },
        "md5": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "provider", "status", "reason", "checked_at", "stale"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "provider": {"$ref": "#/$defs/provider"},
        "status": {
          "type": "string",
          "enum": ["complete", "not_checked", "incomplete"]
        },
        "reason": {
          "oneOf": [
            {"$ref": "#/$defs/failureReason"},
            {"type": "null"}
          ]
        },
        "checked_at": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "stale": {"type": "boolean"}
      }
    },
    "severityVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "score", "source", "base_score"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "score": {"type": "string", "minLength": 1},
        "source": {
          "oneOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "base_score": {
          "oneOf": [
            {"type": "number", "minimum": 0, "maximum": 10},
            {"type": "null"}
          ]
        }
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "id",
        "modified",
        "published",
        "withdrawn",
        "url",
        "severity",
        "fixes",
        "data"
      ],
      "properties": {
        "provider": {"$ref": "#/$defs/provider"},
        "id": {"type": "string", "minLength": 1},
        "modified": {"type": ["string", "null"]},
        "published": {"type": ["string", "null"]},
        "withdrawn": {"type": ["string", "null"]},
        "url": {"type": "string"},
        "severity": {
          "type": "array",
          "items": {"$ref": "#/$defs/severityVector"}
        },
        "fixes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "data": {"type": "object"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "provider", "artifact_sha256", "component_purl"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["artifact_component", "upstream_version"]
        },
        "provider": {"$ref": "#/$defs/provider"},
        "artifact_sha256": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
            {"type": "null"}
          ]
        },
        "component_purl": {"type": ["string", "null"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "id",
        "aliases",
        "summary",
        "severity",
        "score",
        "fixes",
        "evidence",
        "source_records",
        "kev",
        "stale"
      ],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "aliases": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "summary": {"type": ["string", "null"]},
        "severity": {"$ref": "#/$defs/severity"},
        "score": {
          "oneOf": [
            {"type": "number", "minimum": 0, "maximum": 10},
            {"type": "null"}
          ]
        },
        "fixes": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "source_records": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceRecord"}
        },
        "kev": {"type": "boolean"},
        "stale": {"type": "boolean"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "source",
        "reason",
        "message",
        "subject",
        "affects_completeness"
      ],
      "properties": {
        "provider": {"$ref": "#/$defs/provider"},
        "source": {"type": "string", "minLength": 1},
        "reason": {"$ref": "#/$defs/failureReason"},
        "message": {"type": "string", "minLength": 1},
        "subject": {"type": ["string", "null"]},
        "affects_completeness": {"type": "boolean"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked",
        "mapped",
        "unmapped",
        "not_checked",
        "incomplete",
        "total_matches",
        "qualifying_matches"
      ],
      "properties": {
        "checked": {"type": "integer", "minimum": 0},
        "mapped": {"type": "integer", "minimum": 0},
        "unmapped": {"type": "integer", "minimum": 0},
        "not_checked": {"type": "integer", "minimum": 0},
        "incomplete": {"type": "integer", "minimum": 0},
        "total_matches": {"type": "integer", "minimum": 0},
        "qualifying_matches": {"type": "integer", "minimum": 0}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"provider": {"const": "basilisk"}}},
          "then": {"properties": {"provider_experimental": {"const": true}}},
          "else": {"properties": {"provider_experimental": {"const": false}}}
        }
      ],
      "required": [
        "schema_version",
        "generated_at",
        "target",
        "provider",
        "provider_experimental",
        "minimum_severity",
        "subjects",
        "coverage",
        "findings",
        "failures",
        "summary"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "generated_at": {"type": "string", "format": "date-time"},
        "target": {"type": "string"},
        "provider": {"$ref": "#/$defs/provider"},
        "provider_experimental": {"type": "boolean"},
        "minimum_severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "subjects": {
          "type": "array",
          "items": {"$ref": "#/$defs/subject"}
        },
        "coverage": {
          "type": "array",
          "items": {"$ref": "#/$defs/coverage"}
        },
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        },
        "failures": {
          "type": "array",
          "items": {"$ref": "#/$defs/failure"}
        },
        "summary": {"$ref": "#/$defs/summary"}
      }
    },
    "errorReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "error"],
      "properties": {
        "schema_version": {"const": 1},
        "target": {"type": "string"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message"],
          "properties": {
            "message": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
